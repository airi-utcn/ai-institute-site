# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# These values must match between the POSTGRES_* and DATABASE_* variables

POSTGRES_USER=strapi
POSTGRES_PASSWORD=strapi
POSTGRES_DB=strapi

DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi

# =============================================================================
# STRAPI CONFIGURATION
# =============================================================================

NODE_ENV=development                # Use 'production' for production deployments

# Server settings
HOST=0.0.0.0
PORT=1337

# Admin panel and internal URLs
STRAPI_ADMIN_URL=/strapi/admin      # Path where admin panel is accessible
STRAPI_INTERNAL_URL=http://strapi:1337  # Internal Docker service URL

# =============================================================================
# STRAPI SECRETS (CHANGE ALL IN PRODUCTION!)
# =============================================================================
# Generate secure random strings for production using:
#   openssl rand -base64 32
# Never commit real secrets to version control!

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# =============================================================================
# NEXT.JS / FRONTEND CONFIGURATION
# =============================================================================

# Public-facing Strapi URL (used by frontend to fetch data)
# Development: http://localhost:1337
# Production:  https://your-domain.com (no trailing slash)
PUBLIC_STRAPI_URL=http://localhost:1337

# MANDATORY: API token for authenticated requests to Strapi
# Otherwise frontend will not be able to access Strapi at all.
STRAPI_API_TOKEN=changeme_strapi_token

# Redundant for the moment. Will be used for frontend revalidation via Webhooks in the near future.
REVALIDATION_SECRET=changeme_revalidate_secret

# Strapi -> Next.js draft preview
CLIENT_URL=http://localhost:3000
PREVIEW_SECRET=changeme_preview_secret

# =============================================================================
# INSTITUTIONAL LOGIN (NEXT.JS)
# =============================================================================
# Protects equipment reservations with a UTCN Microsoft account.
# See docs/authentication.md for the full setup.

# Entra ID tenant ID (preferred) OR an OIDC issuer URL from an institutional
# broker. Set exactly one of these.
AUTH_MICROSOFT_TENANT_ID=
AUTH_OIDC_ISSUER=

# Application (client) ID and secret for the web app registration.
# A confidential web app needs a secret; a public PKCE-only client can leave
# AUTH_CLIENT_SECRET empty.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Public URL of this Next.js site and the exact callback registered in Entra ID.
AUTH_URL=http://localhost:3000
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Long random value used to encrypt session cookies. Generate with:
#   openssl rand -base64 32
# Never reuse a Microsoft client secret here.
AUTH_SECRET=changeme_auth_secret

# Scopes requested from the identity provider.
AUTH_SCOPES="openid profile email"

# Comma-separated allowlist. A domain also matches its subdomains, so
# "utcluj.ro" allows "student.utcluj.ro". Leave empty to allow any account in
# the configured tenant.
AUTH_ALLOWED_EMAIL_DOMAINS=utcluj.ro

# Optional: require membership in one or more Entra ID security groups (object IDs).
AUTH_ALLOWED_GROUP_IDS=

# Optional: force re-authentication on every login ("login", "select_account",
# or "consent"). Leave empty for the provider default.
AUTH_PROMPT=

# Session lifetime in hours.
AUTH_SESSION_MAX_AGE_HOURS=12

# =============================================================================
# STRAPI ADMIN SSO
# =============================================================================
# Protects https://<domain>/strapi/admin with Microsoft login.

# Set to true to disable local password login and redirect /admin to SSO.
# Defaults to true when all three AZUREAD_* credentials below are present.
ADMIN_SSO_ONLY=

# Optional override for the browser path that starts the admin SSO flow.
# Default is derived from PUBLIC_STRAPI_URL: /strapi/strapi-plugin-sso/azuread
ADMIN_SSO_START_PATH=

# Persist the admin session across browser restarts. When false the Strapi
# refresh cookie is still used, but the session ends with the browser session.
ADMIN_SSO_REMEMBER_ME=false

# Comma-separated list of admin email addresses. These are seeded into the
# plugin whitelist on boot. Leave empty to allow any account in the tenant.
ADMIN_SSO_ALLOWED_EMAILS=
ADMIN_SSO_USE_WHITELIST=false

# Admin app registration. It can be the same registration as the web app, but
# two registrations are cleaner because they have different redirect URIs.
AZUREAD_TENANT_ID=
AZUREAD_OAUTH_CLIENT_ID=
AZUREAD_OAUTH_CLIENT_SECRET=
AZUREAD_OAUTH_REDIRECT_URI=http://localhost:1337/strapi-plugin-sso/azuread/callback
AZUREAD_SCOPE="openid profile email"

# =============================================================================
# SNIPE-IT CONFIGURATION
# =============================================================================

# Public-facing Snipe-IT URL (used by browser and Snipe-IT to generate links and redirects)
# Development: http://localhost:8000
# Production:  https://airi.utcluj.ro/snipeit (no trailing slash)
SNIPEIT_PUBLIC_URL=http://localhost:8000

# Subpath prefix for Livewire AJAX endpoints when hosted in a subdirectory
# Development: /
# Production:  / (APP_URL supplies the public subpath)
SNIPEIT_LIVEWIRE_PREFIX=/

# Internal URL used by Strapi and Next.js (server-side within Docker network)
SNIPEIT_URL=http://snipe-it:80
SNIPEIT_API_KEY=changeme_snipeit_key

# Snipe-IT Application Key (required by Laravel, must be a 32-byte base64 string)
# Generate using: openssl rand -base64 32  and prefix with "base64:"
# Example: base64:ZMgSc2rSHlLrfmMtapEShJEN/bzVQR6mQhrZ5L2XhJU=
SNIPEIT_APP_KEY=changeme_snipeit_app_key

# Snipe-IT Database Configuration (MySQL)
SNIPEIT_DB_DATABASE=snipeit
SNIPEIT_DB_USER=snipeit
SNIPEIT_DB_PASSWORD=changeme_snipeit_db_pass
SNIPEIT_DB_ROOT_PASSWORD=changeme_snipeit_root_pass

# =============================================================================
# RESEARCH PAPER GRAPH CONFIGURATION
# =============================================================================

# Minimum cosine similarity score to create a link between two papers (0.0 - 1.0)
GRAPH_SIMILARITY_THRESHOLD=0.6

# Papers scoring at or above this threshold are considered duplicates and skipped (0.0 - 1.0)
GRAPH_DUPLICATE_THRESHOLD=0.92

# Sentence-transformer model used to generate paper embeddings
# Again, have to be compatible with "sentence-transformers"
# Ref: https://huggingface.co/models?library=sentence-transformers
GRAPH_AI_MODEL=all-MiniLM-L6-v2

# HDBSCAN (paper-level communities)
# Lower values reduce "noise" points and produce denser clusters.
GRAPH_HDBSCAN_MIN_CLUSTER_SIZE=12
GRAPH_HDBSCAN_MIN_SAMPLES=3

# Distance threshold for assigning secondary community memberships.
# Lower values reduce multi-cluster affiliations.
GRAPH_SECONDARY_CLUSTER_DISTANCE_THRESHOLD=0.7

# HDBSCAN (topic superclusters)
GRAPH_TOPIC_HDBSCAN_MIN_CLUSTER_SIZE=3
GRAPH_TOPIC_HDBSCAN_MIN_SAMPLES=2

# Frontend meso-node shaping (constellation level)
# Small groups below this size are merged into "Other Themes".
GRAPH_MESO_MIN_NODE_PAPERS=3
# Hard cap for number of meso nodes shown in one community view.
GRAPH_MESO_MAX_NODES=20
# Keep at least this many meso nodes before merging small groups.
GRAPH_MESO_MIN_NODES=8

# Cron schedule for paper sync (in standard cron format)
PAPER_SYNC_CRON=0 0 * * 6   # Every Saturday at midnight
PAPER_SYNC_TZ=UTC

# =============================================================================
# GITHUB CONTAINER REGISTRY (PROD / WATCHTOWER)
# =============================================================================

REPO_USER=your_github_username
REPO_PASS=your_github_token_with_read_packages_scope

# =============================================================================
# EMAIL CONFIG
# =============================================================================

STMP_HOST=somehost
SMTP_PORT=587
SMTP_USERNAME=someuser
SMTP_PASSWORD=somepass
SMTP_DEFAULT_FROM=somereply
STMP_DEFAULT_REPLY_TO=somereplyto

DRAFT_NOTIFICATION_CRON='0 17 * * *' # Every day at 5PM
DRAFT_NOTIFICATION_ROLE='Editor' # You can add multiple, comma separated
