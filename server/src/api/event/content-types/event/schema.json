{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": false
    },
    "category": {
      "type": "enumeration",
      "default": "event",
      "enum": [
        "conference",
        "workshop",
        "airi_invited_lecture",
        "seminar",
        "roundtable",
        "training",
        "public_debate",
        "research_presentation",
        "networking_event",
        "airi_podcast",
        "talk",
        "event",
        "other"
      ]
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "photoCredits": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "startDate": {
      "required": true,
      "type": "datetime"
    },
    "endDate": {
      "type": "datetime",
      "required": true
    },
    "format": {
      "type": "enumeration",
      "enum": [
        "onsite",
        "online",
        "hybrid"
      ],
      "default": "onsite"
    },
    "location": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "locationType": {
      "type": "enumeration",
      "enum": [
        "airi_utcn",
        "hub_utcn",
        "online",
        "other"
      ],
      "default": "airi_utcn"
    },
    "address": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "roomOrLink": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "host": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "audience": {
      "type": "enumeration",
      "enum": [
        "public",
        "students",
        "researchers",
        "industry",
        "invitation_only"
      ],
      "default": "public"
    },
    "audienceCustom": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "language": {
      "type": "enumeration",
      "enum": [
        "romanian",
        "english",
        "romanian_english",
        "other"
      ],
      "default": "english"
    },
    "contactPerson": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::person.person"
    },
    "contactEmail": {
      "type": "email"
    },
    "contactName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "registrationRequired": {
      "type": "boolean",
      "default": false
    },
    "registrationUrl": {
      "type": "string"
    },
    "registrationEmail": {
      "type": "string"
    },
    "registrationDeadline": {
      "type": "datetime"
    },
    "accessConditions": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "body": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "shared.section",
        "shared.rich-text",
        "shared.media",
        "shared.slider",
        "shared.quote"
      ]
    },
    "additionalNotes": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "privacyNotice": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ctaLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ctaUrl": {
      "type": "string"
    },
    "participants": {
      "type": "component",
      "repeatable": true,
      "component": "event.participant"
    },
    "organizers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::department.department"
    },
    "speakers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::person.person"
    },
    "partners": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::partner.partner"
    },
    "partnerInstitutionsText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project"
    }
  }
}