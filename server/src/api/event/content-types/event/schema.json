{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "startDate": {
      "type": "datetime"
    },
    "endDate": {
      "type": "datetime"
    },
    "location": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "event",
        "workshop",
        "talk",
        "other"
      ],
      "default": "event"
    },
    "ctaLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ctaUrl": {
      "type": "string"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "shared.section",
        "shared.rich-text",
        "shared.media"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "organizers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::department.department"
    },
    "speakers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::person.person"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project"
    }
  }
}
