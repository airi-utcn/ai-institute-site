{
  "kind": "collectionType",
  "collectionName": "laboratories",
  "info": {
    "singularName": "laboratory",
    "pluralName": "laboratories",
    "displayName": "Laboratory",
    "description": "Research laboratories and sponsored spaces"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": false
    },
    "roomNumber": {
      "type": "string"
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "capacity": {
      "type": "integer"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "videoFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos",
        "files"
      ]
    },
    "videoUrl": {
      "type": "string"
    },
    "videoPoster": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "videoTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "videoDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "partners": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::partner.partner",
      "inversedBy": "laboratories"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "virtualTour360Url": {
      "type": "string"
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "shared.cta",
        "shared.card-grid",
        "shared.card",
        "shared.focus-item",
        "shared.section",
        "shared.rich-text",
        "shared.media",
        "shared.slider",
        "shared.separator"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "coordinator": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::person.person"
    },
    "coCoordinator": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::person.person"
    },
    "researchers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::person.person"
    },
    "departments": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::department.department"
    },
    "researchThemes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::research-theme.research-theme"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project"
    },
    "publications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::publication.publication",
      "inversedBy": "laboratories"
    },
    "slides": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::slide.slide",
      "mappedBy": "laboratories"
    },
    "teams": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::team.team",
      "mappedBy": "laboratory"
    },
    "contactEmail": {
      "type": "email"
    },
    "bookingUrl": {
      "type": "string"
    },
    "openHours": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
