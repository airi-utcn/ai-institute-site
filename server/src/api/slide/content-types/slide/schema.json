{
  "kind": "collectionType",
  "collectionName": "slides",
  "info": {
    "singularName": "slide",
    "pluralName": "slides",
    "displayName": "Slide",
    "description": "Presentation decks and slide materials"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": false
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["files"]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "presentationDate": {
      "type": "date"
    },
    "category": {
      "type": "enumeration",
      "enum": ["presentation", "lecture", "seminar", "conference", "other"],
      "default": "presentation"
    },
    "tags": {
      "type": "json"
    },
    "presenters": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::person.person"
    },
    "publications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::publication.publication",
      "inversedBy": "slides"
    },
    "laboratories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::laboratory.laboratory",
      "inversedBy": "slides"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "inversedBy": "slides"
    }
  }
}
