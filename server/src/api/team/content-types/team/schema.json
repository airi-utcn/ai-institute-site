{
  "kind": "collectionType",
  "collectionName": "teams",
  "info": {
    "singularName": "team",
    "pluralName": "teams",
    "displayName": "Team",
    "description": "Working groups of people collaborating on projects"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": false
    },
    "description": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "teams"
    },
    "laboratory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::laboratory.laboratory",
      "inversedBy": "teams"
    },
    "members": {
      "type": "component",
      "component": "team.membership",
      "repeatable": true
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "inversedBy": "teams"
    },
    "category": {
      "type": "enumeration",
      "default": "research",
      "enum": [
        "leadership",
        "research",
        "project",
        "support",
        "other"
      ]
    },
    "displayOrder": {
      "type": "integer",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "category"
            },
            "leadership"
          ]
        }
      },
      "default": 0
    },
    "subtitle": {
      "type": "string"
    }
  }
}
