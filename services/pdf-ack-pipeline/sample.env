# =============================================================================
# PRODUCTION CONFIGURATION SAMPLE — PDF ACKNOWLEDGMENT PIPELINE
# Copy this file to `.env` and fill in `STRAPI_API_TOKEN`.
# =============================================================================

# =============================================================================
# RABBITMQ CONNECTION & QUEUES
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

TASKS_QUEUE_NAME=tasks_queue
RESULTS_QUEUE_NAME=results_queue

# =============================================================================
# STORAGE & STATE PATHS
# =============================================================================
PDF_STORAGE_DIR=./data/pdfs
STATE_DB_PATH=./data/state/processed_papers.db
MODEL_CACHE_DIR=./worker_service/.model_cache

# =============================================================================
# WORKER AI SETTINGS (Microservice 2)
# =============================================================================
AI_BI_MODEL=all-MiniLM-L6-v2
AI_CROSS_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
AI_CONFIDENCE_THRESHOLD=0.55
AI_BI_THRESHOLD=0.60
AI_CROSS_THRESHOLD=0.05
AI_TOP_K=5

# Stage 3: Small Language Model (SLM) post-processing for PDF artifact cleanup
AI_SLM_ENABLED=true
AI_SLM_MODEL=Qwen/Qwen3.5-0.8B
AI_SLM_PROMPT_FILE=./worker_service/semantic_data/slm_cleanup_prompt.txt
AI_SLM_MAX_NEW_TOKENS=512
AI_SLM_TEMPERATURE=0.2

WORKER_POLL_INTERVAL_SECONDS=5
WORKER_IDLE_EXIT_SECONDS=60

# =============================================================================
# COORDINATOR & STRAPI PRODUCTION SETTINGS (Microservice 1)
# =============================================================================
STRAPI_URL=https://airi.utcluj.ro/strapi
PUBLIC_STRAPI_URL=https://airi.utcluj.ro/strapi
NEXT_PUBLIC_STRAPI_URL=https://airi.utcluj.ro/strapi
STRAPI_INTERNAL_URL=https://airi.utcluj.ro/strapi

# Full-access API token from production Strapi Admin (Settings -> API Tokens)
STRAPI_API_TOKEN=
STRAPI_PAGE_SIZE=100
STRAPI_TIMEOUT_SECONDS=30

# Stream PDFs in 64KB memory chunks to compute exact SHA-256 without saving to disk
COMPUTE_SHA256_STREAM=true

# Leave empty in production so all publications are fetched directly from Strapi
ACK_TEST_PDF_URLS=

# Process all publications in Strapi per sync run (0 = unlimited / all PDFs)
ACK_MAX_PAPERS_PER_RUN=0

# Cron schedule shared by both coordinator and worker (Saturday at 02:00 UTC)
ACK_SYNC_CRON=0 2 * * 6
ACK_SYNC_TZ=UTC

# Run an immediate full sync & worker batch when containers start
ACK_RUN_ON_STARTUP=true

# Automatic retry settings if worker crashes or does not respond in time
TASK_RETRY_TIMEOUT_SECONDS=300
MAX_TASK_RETRIES=3
COORDINATOR_RESULT_POLL_SECONDS=1.0
