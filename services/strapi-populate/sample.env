# Copy this file to `.env` (same folder) and fill in your local token.
# `.env` is git-ignored; this sample is safe to commit.

# Full-access API token created in local Strapi Admin:
# http://localhost:1337/strapi/admin -> Settings -> API Tokens -> Create new API Token (Full access)
STRAPI_API_TOKEN=

# Target local Strapi
LOCAL_STRAPI_URL=http://localhost:1337

# Source public Strapi to copy publications + PDFs from
SEED_PUBLIC_STRAPI_URL=https://airi.utcluj.ro/strapi
